#include<stdio.h>
int main(){
    int n,original;
    printf("enter number");
    scanf("%d",&n);
    original=n;
     int reverse=0,digit;
    while(n>0){
        digit=n%10;
        reverse=reverse*10+digit;
        n=n/10;  
    }
    if(original==reverse){
        printf("number is palindrome");
    }
    else{
        printf("number is not palindrome");
    }
    return 0;
}
