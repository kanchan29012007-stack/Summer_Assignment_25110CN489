#include <stdio.h>

int main() {
    int a[10][10], n;
    int primary = 0, secondary = 0;

    printf("Enter the order of the matrix: ");
    scanf("%d", &n);

    printf("Enter the elements of the matrix:\n");
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    for (int i = 0; i < n; i++) {
        primary += a[i][i];
        secondary += a[i][n - 1 - i];
    }

    printf("Primary diagonal sum = %d\n", primary);
    printf("Secondary diagonal sum = %d\n", secondary);

    return 0;
}
